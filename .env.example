# Copie para .env e preencha:  cp .env.example .env

# --- Modelo de linguagem ------------------------------------------------------
# Chave do OpenRouter (https://openrouter.ai/keys). OPENROUTER_API_KEY também é aceita.
LLM_API_KEY=

# Modelo usado pelo agente. O padrão é um preset do OpenRouter, onde o modelo,
# os fallbacks e os parâmetros são configurados pela plataforma.
# Para testar outro modelo basta trocar esta linha, por exemplo:
#   LLM_MODEL=anthropic/claude-sonnet-4.5
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=google/gemini-2.5-flash
# Lista completa: https://openrouter.ai/models
LLM_MODEL=@preset/emporio-agent

# Opcional: modelo barato para tarefas auxiliares (guardrails, avaliação).
# LLM_FAST_MODEL=openai/gpt-4o-mini

# Opcional: fallbacks enviados na própria requisição, separados por vírgula
# (use com um modelo concreto em LLM_MODEL; presets já têm fallbacks próprios).
# LLM_FALLBACK_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash

# Opcional: outro provedor compatível com a API da OpenAI.
# LLM_BASE_URL=https://api.openai.com/v1                 # OpenAI direto
# LLM_BASE_URL=http://localhost:11434/v1                 # Ollama local (sem chave)

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024     # limite da resposta; evita reserva excessiva de crédito
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# --- Busca no manual de políticas ---------------------------------------------
# Embeddings usam a mesma chave/endpoint do LLM. Deixe vazio para usar só BM25 (sem rede).
# EMBEDDING_MODEL=google/gemini-embedding-001   # melhor na avaliação (uv run emporio-eval-retrieval)
# RETRIEVAL_MODE=embeddings    # embeddings | hybrid | bm25 (bm25 = sem rede)

# --- Observabilidade (Langfuse) ------------------------------------------------
# Para um Langfuse local, sem conta: docker compose --profile observability up
# e descomente as três linhas abaixo (chaves criadas automaticamente pelo compose;
# login em http://localhost:3000 com admin@emporio.local / emporio-local).
# Nos containers o host é ajustado sozinho para http://langfuse-web:3000.
# LANGFUSE_PUBLIC_KEY=pk-lf-emporio-local
# LANGFUSE_SECRET_KEY=sk-lf-emporio-local
# LANGFUSE_HOST=http://localhost:3000

# --- Relógio ------------------------------------------------------------------
# Fixa a data/hora vista pelo agente (demonstrações e testes). Sem fuso = horário da loja.
# EMPORIO_NOW=2026-03-25T10:30

# --- Dados --------------------------------------------------------------------
# EMPORIO_DB_PATH=data/processed/emporio.db
# EMPORIO_STATE_DIR=var          # histórico das conversas e atendimentos encaminhados
